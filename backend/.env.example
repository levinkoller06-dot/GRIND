# Supabase → Project Settings → API
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Nur bei älteren Projekten mit "Legacy JWT Secret" nötig
SUPABASE_JWT_SECRET=

# Supabase → Project Settings → API Keys → Secret keys (sb_secret_...)
# Für Morgen-Check, Erinnerungen und Mail-Abruf im Hintergrund. Leer = Zeitplan aus.
# Umgeht Row Level Security – nur hier eintragen, nie ins Frontend!
SUPABASE_SECRET_KEY=
# Mails alle X Minuten im Hintergrund abrufen
MAIL_CHECK_MIN=15

FRONTEND_ORIGINS=["http://localhost:3000"]

# Google AI Studio → Get API key (geheim!)
GEMINI_API_KEY=
# Kommagetrennt, wird der Reihe nach probiert
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash

# Verschlüsselt Mail-Passwörter. Erzeugen mit:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Jev (TypeSafe AI) über OpenRouter – für schnelle Entscheidungen (optional)
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
# Von Jev sicher erkannte Werbung automatisch in den Papierkorb (false = nur vorschlagen)
MAIL_AUTO_TRASH_ADS=true
# Termine und Mails (senden/löschen) erst nach Bestätigung in der App ausführen
CONFIRM_ACTIONS=false
